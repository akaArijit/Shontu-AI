# ============================================================
# Fund Engine Web - Environment Variables (Vercel)
# These are inlined at build time; redeploy after changing them.
# ============================================================

# Bare Railway API origin (no /api/v1 suffix, no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo mode: serve generated data without the API. Keep false in production.
NEXT_PUBLIC_USE_MOCK_API=false

# Canonical site URL, used for metadata/OpenGraph tags.
# NEXT_PUBLIC_SITE_URL=https://fund-engine.vercel.app
