{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m fund_engine.services.pipeline",
    "cronSchedule": "0 2 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
