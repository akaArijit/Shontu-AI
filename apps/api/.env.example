# ============================================================
# Fund Engine API - Environment Variables
# Copy to .env for local runs, or paste into Railway variables.
# ============================================================

# Database (required: API + batch)
DATABASE_URL=postgresql://fund_user:fund_password@localhost:5432/fund_engine
# Railway: reference the Postgres plugin instead of copying the URL
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Config files (optional: defaults point at ./config)
SCORING_CONFIG_PATH=./config/scoring_config.yaml
RULES_CONFIG_PATH=./config/rules.yaml
BENCHMARK_MAPPINGS_PATH=./config/explicit_benchmark_mappings.json

# API
# Railway injects PORT automatically; set only for local runs.
PORT=8000
# Comma-separated allowed browser origins (Vercel production domain + local dev).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for Vercel preview deployments, e.g.:
# ALLOWED_ORIGIN_REGEX=https://fund-engine-[a-z0-9-]+\.vercel\.app
