# MFD Fund Monitoring - Environment Variables Template
# Copy to .env and fill in values

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://fund_user:fund_password@localhost:5432/fund_engine
DB_PASSWORD=fund_password

# Supabase (for production)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# REDIS (for API caching/rate limiting)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# EXTERNAL APIs (Optional - for enhanced data)
# ============================================================
# MFAPI
MFAPI_BASE_URL=https://api.mfapi.in/mf

# NSE Indices
NSE_API_KEY=

# RBI/MOSPI/FBIL (scraping endpoints)
RBI_SCRAPER_ENABLED=true

# ============================================================
# CONFIG FILES
# ============================================================
SCORING_CONFIG_PATH=./config/scoring_config.yaml
RULES_CONFIG_PATH=./config/rules.yaml
BENCHMARK_MAPPINGS_PATH=./config/explicit_benchmark_mappings.json

# ============================================================
# APPLICATION SETTINGS
# ============================================================
LOG_LEVEL=info
TIMEZONE=Asia/Kolkata
PORT=8000

# API Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
API_KEY_SALT=your-api-key-salt

# CORS (for MFD dashboard)
ALLOWED_ORIGINS=http://localhost:3000,https://mfd-dashboard.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# PIPELINE SETTINGS
# ============================================================
PIPELINE_TIMEOUT_SECONDS=1800
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY_SECONDS=5

# ============================================================
# NOTIFICATIONS (Optional)
# ============================================================
# WhatsApp Business API
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_TEMPLATE_NAMESPACE=

# Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_FROM=alerts@yourdomain.com