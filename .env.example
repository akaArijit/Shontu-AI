# MFD Fund Monitoring - Environment Variables Template
# Copy to .env (local) or paste into the Railway service Variables tab.
# Only variables listed here are read by the application.

# ============================================================
# DATABASE (required: API + batch)
# ============================================================
DATABASE_URL=postgresql://fund_user:fund_password@localhost:5432/fund_engine

# Railway: reference the Postgres plugin instead of copying the URL
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ============================================================
# CONFIG FILES (optional: defaults point at ./config)
# ============================================================
SCORING_CONFIG_PATH=./config/scoring_config.yaml
RULES_CONFIG_PATH=./config/rules.yaml
BENCHMARK_MAPPINGS_PATH=./config/explicit_benchmark_mappings.json

# ============================================================
# API SETTINGS
# ============================================================
# Railway injects PORT automatically; set only for local runs.
PORT=8000

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
# FRONTEND (build-time, Next.js)
# ============================================================
# Bare API origin, no /api/v1 suffix.
# NEXT_PUBLIC_API_URL=https://<api-service>.up.railway.app
# Set true only for UI demos without a database.
# NEXT_PUBLIC_USE_MOCK_API=false
