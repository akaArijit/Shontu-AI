{
  "name": "fund-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Fund monitoring and scoring monorepo — FastAPI API/batch (Railway) + Next.js dashboard (Vercel)",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "install:web": "npm --prefix apps/web ci",
    "test": "npm run test:api",
    "test:api": "cd apps/api && python -m pytest -q",
    "migrate": "cd apps/api && python scripts/apply_migrations.py",
    "seed:benchmarks": "cd apps/api && python scripts/seed_benchmarks.py --years 6",
    "pipeline": "cd apps/api && python scripts/run_nightly.py"
  },
  "engines": {
    "node": ">=18.17"
  }
}
